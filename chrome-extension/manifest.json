{
  "manifest_version": 3,
  "name": "ScanSurat UNKRIS",
  "version": "1.0.0",
  "description": "Aplikasi pengisi form portal UNKRIS dengan data dari pemindai surat",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://puskom.unkris.ac.id/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScanSurat UNKRIS"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://puskom.unkris.ac.id/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
